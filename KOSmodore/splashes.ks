@LAZYGLOBAL OFF.

// putroppo per usare i colori non si può usare at(X,Y)

FUNCTION mainsplash40x20 {
   CLEARSCREEN.	
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT "           ==================".
   PRINT "[#FFFFFF]              KOS[#8F8FFF] Computer".
   PRINT "           ==================".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   
   //print "FF0000" AT (2,7).     //un bel trick
   }


FUNCTION mainsplash {
   CLEARSCREEN.	
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT "                      ===================================".
   PRINT "[#FFFFFF][/hw]              kOS[#8F8FFF]-Computer".
   PRINT "                      ===================================".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   PRINT " ".
   
   //print "FF0000" AT (2,7).     //un bel trick
   }